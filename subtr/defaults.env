# subtr — alapértelmezett provider / modell / effort a négy LLM-es parancshoz.
#
# Ez az EGYETLEN hely, ahol alapérték van: a kódban nincs beégetett modellnév
# vagy provider. Ezt a fájlt NE szerkeszd a saját beállításaidhoz — ugyanezeket
# a sorokat írd a .env-be, az felülírja az ittenieket. Az éppen érvényes
# beállítást a `py subtr.py config` mutatja.
#
# Feloldás: parancssori kapcsoló > .env / környezet > ez a fájl. A .env bármely
# sora (a provider-szintű is) erősebb az itteni soroknál; egy fájlon belül:
#   provider: --provider > SUBTR_<FUNKCIÓ>_PROVIDER
#   modell:   --model    > SUBTR_<FUNKCIÓ>_MODEL  > SUBTR_<PROVIDER>_MODEL
#   effort:   --effort   > SUBTR_<FUNKCIÓ>_EFFORT > SUBTR_<PROVIDER>_EFFORT
# A funkció MODEL / EFFORT sora a funkció PROVIDER sorához tartozik: ha más
# providerrel futtatsz (--provider, vagy a .env-ben csak a providert írod át),
# a provider-szintű sorok lépnek be.
#
# Üres érték: modellnél a provider CLI-je a saját alapértelmezésével fut
# (a Gemini API-nál a modell kötelező); effortnál nem megy át szint.
# Effort: low | medium | high | xhigh | max — a claude-nál kapcsoló, az
# antigravity-nél a modellnév utótagja (csak low | medium | high); a gemini,
# codex és grok providernél nincs hatása.

# ── Funkciónként ────────────────────────────────────────────────────────────
SUBTR_TRANSLATE_PROVIDER=claude
SUBTR_TRANSLATE_MODEL=sonnet
SUBTR_TRANSLATE_EFFORT=

SUBTR_REVIEW_PROVIDER=antigravity
SUBTR_REVIEW_MODEL=gemini-3.8-flash
SUBTR_REVIEW_EFFORT=high

SUBTR_GLOSSARY_PROVIDER=claude
SUBTR_GLOSSARY_MODEL=
SUBTR_GLOSSARY_EFFORT=

SUBTR_REGISTER_PROVIDER=gemini
SUBTR_REGISTER_MODEL=gemini-3.8-flash
SUBTR_REGISTER_EFFORT=

# ── Providerenként (ha a funkciót nem a fenti providerével futtatod) ────────
SUBTR_GEMINI_MODEL=gemini-3.8-flash
SUBTR_CLAUDE_MODEL=sonnet
SUBTR_CODEX_MODEL=
SUBTR_GROK_MODEL=grok-4.5
SUBTR_ANTIGRAVITY_MODEL=gemini-3.8-flash
SUBTR_ANTIGRAVITY_EFFORT=high
