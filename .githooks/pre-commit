#!/bin/sh
# Commit előtti szűrő: jogvédett / sorozat-specifikus tartalom és titok ne
# kerüljön a repóba. Részletek: scripts/check_copyright.py
#
# Bekapcsolás (egyszer, clone után):   git config core.hooksPath .githooks
# Kihagyás egyszer:                     SKIP_COPYRIGHT_CHECK=1 git commit …
#                                       vagy git commit --no-verify

root="$(git rev-parse --show-toplevel)"
script="$root/scripts/check_copyright.py"

if command -v python3 >/dev/null 2>&1; then
    py=python3
elif command -v python >/dev/null 2>&1; then
    py=python
elif command -v py >/dev/null 2>&1; then
    py="py -3"
else
    echo "pre-commit: nincs python a PATH-on, a check_copyright kimaradt." >&2
    exit 0
fi

exec $py "$script"
