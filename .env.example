# Másold át ezt a fájlt .env néven, és töltsd ki a saját API kulcsoddal.
# A .env fájlt NE commit-old git-be (érzékeny adat).

# Gemini API kulcs — szerezd be: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Modell-defaultok — nem kötelező, de hasznos testreszabáshoz.
# A scriptek ezeket betöltik, de ha nincs beállítva, a beégetett default-ot használják.

# Gemini default modell minden feladathoz (translate, review, glossary, register)
# SUBTR_GEMINI_MODEL=gemini-3.6-flash

# Task-specifikus modell-felülbírálások Gemini-hez:
# SUBTR_GEMINI_MODEL_TRANSLATE=gemini-3.5-flash-lite    # olcsóbb fordításhoz
# SUBTR_GEMINI_MODEL_REVIEW=gemini-3.6-flash            # erősebb review-hoz
# SUBTR_GEMINI_MODEL_GLOSSARY=gemini-3.5-flash-lite     # szójegyzék-bővítéshez
# SUBTR_GEMINI_MODEL_REGISTER=gemini-3.6-flash          # regiszter extractionhez

# Claude CLI modell-beállítások (ugyanez a logika: generikus + task-specifikus)
# SUBTR_CLAUDE_MODEL=sonnet
# SUBTR_CLAUDE_MODEL_TRANSLATE=opus                     # Opus fordítással, Sonnet review-val
# SUBTR_CLAUDE_MODEL_REVIEW=sonnet

# Codex CLI modell-beállítások
# SUBTR_CODEX_MODEL=gpt-5.5-standard
# SUBTR_CODEX_MODEL_TRANSLATE=gpt-5.5-turbo

# Default provider glossary_extract.py és register_extract.py-hoz
# (enélkül: glossary_extract → claude, register_extract → gemini)
# SUBTR_DEFAULT_PROVIDER=gemini
