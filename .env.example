# Másold át ezt a fájlt .env néven, és töltsd ki a saját API kulcsoddal.
# A .env fájlt NE commit-old git-be (érzékeny adat).

# Gemini API kulcs — szerezd be: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# TMDB API kulcs — csak az addons/tmdb-init add-onhoz (új sorozat indítása).
# Ingyenes, regisztráció után: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=your-tmdb-key-here

# ── Provider / modell / effort a négy LLM-es parancshoz ──────────────────────
# Nem kötelező: ami itt nincs megadva, az a subtr/defaults.env alapértékével fut
# (a kódban nincs beégetett provider vagy modellnév). Hogy ebből a mappából éppen
# mi futna, és melyik érték honnan jön:   py subtr.py config
#
# Feloldás: parancssori kapcsoló > ez a fájl > subtr/defaults.env. Ennek a
# fájlnak bármely sora (a provider-szintű is) erősebb a defaults.env-nél;
# egy fájlon belül:
#   provider: --provider > SUBTR_<FUNKCIÓ>_PROVIDER
#   modell:   --model    > SUBTR_<FUNKCIÓ>_MODEL  > SUBTR_<PROVIDER>_MODEL
#   effort:   --effort   > SUBTR_<FUNKCIÓ>_EFFORT > SUBTR_<PROVIDER>_EFFORT
#
# Provider: gemini | claude | codex | grok | antigravity
# Effort:   low | medium | high | xhigh | max — a claude-nál a CLI kapcsolója, az
#           antigravity-nél a modellnév utótagja (csak low | medium | high);
#           a gemini, codex és grok providernél nincs hatása.
# Üres érték (pl. SUBTR_REVIEW_EFFORT=) is beállítás: modellnél a provider CLI-je
# a saját alapértelmezésével fut, effortnál nem megy át szint.
# A funkció MODEL / EFFORT sora a funkció PROVIDER sorához tartozik — ha a
# providert átírod, írd át mellé a modellt is (különben a provider-szintű sor lép be).

# Fordítás (defaults.env: claude / sonnet / –)
# SUBTR_TRANSLATE_PROVIDER=claude
# SUBTR_TRANSLATE_MODEL=opus
# SUBTR_TRANSLATE_EFFORT=medium

# Review (defaults.env: antigravity / gemini-3.8-flash / high)
# SUBTR_REVIEW_PROVIDER=antigravity
# SUBTR_REVIEW_MODEL=gemini-3.8-flash
# SUBTR_REVIEW_EFFORT=high

# Szójegyzék-kinyerés (defaults.env: claude / a CLI sajátja / –)
# SUBTR_GLOSSARY_PROVIDER=claude
# SUBTR_GLOSSARY_MODEL=sonnet
# SUBTR_GLOSSARY_EFFORT=low

# Megszólítási regiszter (defaults.env: gemini / gemini-3.8-flash / –)
# SUBTR_REGISTER_PROVIDER=gemini
# SUBTR_REGISTER_MODEL=gemini-3.8-flash
# SUBTR_REGISTER_EFFORT=

# Provider-szintű tartalék — akkor érvényes, ha egy funkciót nem a fenti
# providerével futtatsz (pl. `review --provider grok`).
# SUBTR_GEMINI_MODEL=gemini-3.8-flash
# SUBTR_CLAUDE_MODEL=sonnet
# SUBTR_CLAUDE_EFFORT=medium
# SUBTR_CODEX_MODEL=gpt-5.5-standard
# SUBTR_GROK_MODEL=grok-4.5
# SUBTR_ANTIGRAVITY_MODEL=gemini-3.8-flash
# SUBTR_ANTIGRAVITY_EFFORT=high

# A Grok CLI-hez a CLI loginja vagy XAI_API_KEY kell.
# XAI_API_KEY=xai-...

# A korábbi SUBTR_DEFAULT_PROVIDER, SUBTR_<PROVIDER>_MODEL_<FUNKCIÓ> és
# SUBTR_<PROVIDER>_EFFORT_<FUNKCIÓ> nevek megszűntek: ha ilyen sor marad a
# .env-ben, a parancs megáll, és megnevezi az új nevet.

# ── addons/mkv-subs/embed_subs.py: a kész magyar felirat az mkv-ba ──────────
# 1 = a beágyazott sáv legyen az alapértelmezett (a többiről a default
# jelölés lekerül); egy futásra a --no-default / --default felülírja.
# MKV_SUBS_DEFAULT=0

# ── addons/hardsub-cover: a videóba égetett idegen felirat takarása ─────────
# Csak akkor kell, ha a forrásvideóban beégetett (pl. kínai) felirat van.
# A cover_ass.py a magyar feliratot fekete, a szöveg méretéhez igazodó dobozba
# teszi, és a beégetett felirat helyére pozicionálja. Elsőbbség: parancssori
# kapcsoló > ez a fájl > beégetett alapérték (az alábbi, 720p-s értékek).
#
# Koordináta-rendszer (SZÉLxMAG). A lejátszó a valós felbontásra skáláz, így a
# 1280x720-ban megadott értékek egy azonos elrendezésű 1080p videón is jók.
# A pozíciókat ebben a rendszerben mérd (pl. egy kimentett képkockán):
#   ffmpeg -ss 00:06:08 -i "Season 01/…S01E01.mkv" -frames:v 1 frame.png
# HARDSUB_PLAY_RES=1280x720
#
# A beégetett felirat középpontja. Az Y az alsó sor helye: kétsoros magyar
# feliratnál a felső sor e fölé kerül, így az alsó takarja a beégetettet.
# HARDSUB_X=640
# HARDSUB_Y=650
#
# Betűtípus és méret. A LINE_HEIGHT egy kirajzolt sor magassága (~1,2 × méret):
# ebből számolja a kétsoros és az időben átfedő (egymás fölé rakott) feliratok
# helyét — betűméret-váltáskor arányosan állítsd.
# HARDSUB_FONT=Arial
# HARDSUB_FONT_SIZE=40
# HARDSUB_LINE_HEIGHT=48
#
# A doboz belső margója a szöveg körül. Nagyobb érték = magasabb és szélesebb
# doboz; ha a beégetett felirat teteje/alja kilátszik, ezt növeld.
# HARDSUB_PAD=12
#
# A doboz átlátszósága: 0 = teljesen fedő fekete, 255 = láthatatlan.
# Takaráshoz 0 kell; 64–128 körül félig áttetsző lesz.
# HARDSUB_BOX_ALPHA=0
